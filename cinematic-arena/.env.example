# Real email OTP via Resend — copy to .env.local and fill in.
# Get an API key at https://resend.com/api-keys (free tier allows sending to your own email).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
OTP_EMAIL_FROM=NEXT LEVEL ARENA <onboarding@resend.dev>

# Optional: restrict real email delivery to a single domain during testing.
# Leave empty to allow sending to any verified recipient.
# OTP_EMAIL_TO_DOMAIN=yourdomain.com
